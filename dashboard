    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Exam</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody id="tableBody">
    </tbody>

</table>
